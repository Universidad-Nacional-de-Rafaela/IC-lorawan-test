# Copiar a .env y ajustar:  cp .env.example .env
# El .env NO va al repo (está en .gitignore).

# --- Región LoRaWAN ---------------------------------------------------------
# Argentina usa AU915. En ChirpStack las sub-bandas son 0-indexadas, así que
# la sub-banda 2 (canales 8-15 + 65) es "au915_1".
# Tiene que coincidir con:
#   - enabled_regions en configuration/chirpstack/chirpstack.toml
#   - el plan de canales configurado en el packet forwarder del gateway
CHIRPSTACK_REGION=au915_1

# --- Dirección donde escucha el puerto 1700/udp -----------------------------
# 0.0.0.0  -> escucha en todas las interfaces. Es el valor con el que hay que
#             arrancar, porque mientras enp5s0 no tenga IP Docker no puede
#             bindear una dirección que todavía no existe.
# Una vez creado el perfil de red del cable (Fase 2), cambiar a:
#   UDP_BIND_ADDR=192.168.23.100
# para que el puerto quede expuesto solo en la red privada del gateway y no en
# el WiFi de la facultad.
UDP_BIND_ADDR=0.0.0.0

# --- Credenciales -----------------------------------------------------------
POSTGRESQL_PASSWORD=chirpstack

# Secreto para firmar los tokens de login y de API.
# Generar uno propio con:  openssl rand -base64 32
CHIRPSTACK_API_SECRET=cambiame-por-favor-openssl-rand-base64-32
